{
  "manifest_version": 3,
  "name": "Aureon Cross — Universal Screen Intelligence",
  "version": "2.0.0",
  "description": "Real-time AI screen analysis with recording, chat overlay, visual annotations, and instant alerts on any tab.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "tabCapture",
    "offscreen",
    "desktopCapture"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tradingview.com/*",
        "*://*.binance.com/*",
        "*://*.coinbase.com/*",
        "*://*.kraken.com/*",
        "*://*.hyperliquid.xyz/*",
        "*://*.bybit.com/*",
        "*://*.bitget.com/*",
        "*://*.okx.com/*",
        "*://*.kucoin.com/*",
        "*://*.mexc.com/*",
        "*://*.gate.io/*",
        "*://*.bitfinex.com/*",
        "*://*.bitstamp.net/*",
        "*://*.gemini.com/*",
        "*://*.crypto.com/*",
        "*://*.dydx.exchange/*",
        "*://*.gmx.io/*",
        "*://aureonai.app/*",
        "*://*.lovable.app/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon-48.png",
    "128": "icon.png"
  }
}