<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows AppInstaller manifest for asherin.ide.

  Before the first real release, replace:
    TODO_CN_FROM_YOUR_CODE_SIGNING_CERT  -> the exact CN of the code-signing
                                            certificate used by SignTool. It
                                            must match the MSIX Publisher byte
                                            for byte or Windows refuses install.
    Version="0.9.0.0"                    -> the built package version (4 parts).
    Hash / size                          -> not required here; the MSIX itself
                                            carries its signature.

  The MSIX at the Uri below is not published yet. Until it is, the landing
  button stays disabled from updates/latest.json rather than pointing users at
  a URL that 404s.
-->
<AppInstaller
  xmlns="http://schemas.microsoft.com/appx/appinstaller/2018"
  Version="0.9.0.0"
  Uri="https://asherin.com/asherin.ide/install/asherin.appinstaller">

  <MainPackage
    Name="AsherinIDE"
    Publisher="CN=TODO_CN_FROM_YOUR_CODE_SIGNING_CERT"
    Version="0.9.0.0"
    ProcessorArchitecture="x64"
    Uri="https://asherin.com/asherin.ide/install/asherin-x64.msix" />

  <UpdateSettings>
    <OnLaunch HoursBetweenUpdateChecks="8" ShowPrompt="true" UpdateBlocksActivation="false" />
    <AutomaticBackgroundTask />
    <ForceUpdateFromAnyVersion>false</ForceUpdateFromAnyVersion>
  </UpdateSettings>
</AppInstaller>
